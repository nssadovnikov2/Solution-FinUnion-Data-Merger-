@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
title Целевая архитектура данных FinUnion Group (To-Be, 12 месяцев)

actor "Клиент" as Client
actor "Сотрудник банка" as Employee
actor "Финансовый аналитик" as Analyst
actor "Регулятор" as Regulator

rectangle "Операционный контур (OLTP)" #LightBlue {
  component "FU CRM" as CRM
  component "FU Core Banking" as Core
  component "FU Cards" as Cards
  component "FU Loans" as Loans
  component "MDM Customer Hub" as MDM
}

rectangle "Интеграционный слой" #LightYellow {
  component "Integration Layer (Kafka / ESB)" as Integration
  component "CDC (Debezium)" as CDC
  component "Airflow (оркестрация)" as Airflow
}

rectangle "Аналитический контур (OLAP)" #LightGreen {
  component "DWH (PostgreSQL)" as DWH
  database "Data Lakehouse\n(Iceberg + Trino)" as Lakehouse
  component "BI (Tableau / Power BI)" as BI
  component "Data Catalog & Lineage\n(DataHub)" as DataHub
}

' === Потоки данных ===
Client --> CRM : взаимодействие
Employee --> CRM : работа с клиентом

CRM --> Integration : клиентские данные (CDC)
Core --> Integration : счета, договоры, транзакции (CDC)
Cards --> Integration : карточные операции (CDC)
Loans --> Integration : кредитные договоры (CDC)

Integration --> MDM : дедупликация и обогащение клиентов
MDM --> Integration : золотая запись клиента
Integration --> CRM : обновление master_id

Integration --> DWH : ELT-загрузка (Airflow)
Integration --> Lakehouse : потоковая загрузка (Kafka)

CDC --> Integration : поток изменений (near real-time)

DWH --> BI : витрины данных (SQL)
Lakehouse --> BI : аналитика по большим данным (Trino)

DWH --> Regulator : регуляторная отчётность (выгрузки)
Lakehouse --> Analyst : ad-hoc аналитика (SQL / Trino)

DataHub --> Integration : метаданные и lineage
DataHub --> DWH : каталог витрин
DataHub --> Lakehouse : каталог данных и lineage

Airflow --> DWH : оркестрация ELT-пайплайнов
Airflow --> Lakehouse : оркестрация batch-обработки

note right of DataHub
  Централизованный каталог:
  - владельцы данных
  - происхождение (lineage)
  - качество данных
  - поиск и обнаружение
end note

note right of Lakehouse
  Data Lakehouse:
  - Iceberg (табличный формат)
  - Trino (движок запросов)
  - MinIO / S3 (хранение)
  - Для исторических и событийных данных
end note

note right of MDM
  MDM Customer Hub:
  - золотая запись клиента
  - дедупликация
  - управление идентификаторами
  - cross-reference таблицы
end note

legend right
  <#LightBlue> **Операционный контур** – системы-источники
  <#LightYellow> **Интеграционный слой** – потоки и оркестрация
  <#LightGreen> **Аналитический контур** – хранение и аналитика
  Сплошные стрелки – синхронные/асинхронные потоки
  Пунктирные стрелки – batch / ELT
endlegend

@enduml
